#!/bin/bash

# fail fast: a failed step must stop provisioning, not yield a half-configured host
set -eo pipefail

# version hard-coded to prevent installing unknown (potentially broken) versions of compose.
# https://github.com/docker/compose/issues/6268#issuecomment-576628705
DOCKER_COMPOSE_VERSION=1.25.4
RVM_INSTALLER_URL="https://raw.githubusercontent.com/wayneeseguin/rvm/stable/binscripts/rvm-installer"
CODEDEPLOY_INSTALLER_URL="https://aws-codedeploy-us-east-1.s3.amazonaws.com/latest/install"
# pinned like the other installers: "latest" is replaced in place by AWS
CWAGENT_DEB_URL="https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/1.300074.1b2005/amazon-cloudwatch-agent.deb"
# pinned: the unversioned bundle now requires Python >= 3.10, which these hosts lack
AWSCLI_INSTALLER_URL="https://s3.amazonaws.com/aws-cli/awscli-bundle-1.19.112.zip"

# hostname config (for sudo to work properly)
# IMDSv2 (token) so this keeps working when the launch template requires it
# (SOP-621); it works with IMDSv1-optional hosts too. -f makes a failed lookup
# abort provisioning instead of writing an error page into /etc/hosts.
IMDS_TOKEN="$(curl -sf -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 300" http://169.254.169.254/latest/api/token)"
LOCAL_IPV4="$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)"
echo "$LOCAL_IPV4" "$(hostname)" | sudo tee -a /etc/hosts

# packages
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
               -o Dpkg::Options::="--force-confdef" \
               -o Dpkg::Options::="--force-confold"
apt-get install -y \
        jq \
        rpm \
        htop \
        libaio1 \
        libpq-dev \
        libmysqlclient-dev \
        mysql-client \
        libgmp3-dev \
        wget \
        python-pip \
        unzip \
        libwww-perl \
        libdatetime-perl \
        gnupg2

# codedeploy - install here (needs the apt-installed system ruby, before RVM
# below changes what 'ruby' resolves to for a login shell). Starting the agent
# is deferred to the end of the script - see below - so CodeDeploy can't hand
# this instance a deployment before docker-compose is actually installed.
apt-get -y install ruby-full
cd /home/ubuntu || true
wget "$CODEDEPLOY_INSTALLER_URL"
chmod +x install
bash -l -c "sudo ./install auto"
#sudo ./install auto

# docker - install from Docker's apt repo with an explicit package list.
# get.docker.com installs Docker's CURRENT package set, which now includes
# docker-model-plugin. That package does not exist for bionic, and because apt
# installs are atomic the whole transaction fails - leaving the host with no
# Docker at all. Pinning the package list keeps us to what the repo actually has.
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | apt-key add -
add-apt-repository -y \
  "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
apt-get update
# docker - cap json-file container logs (SOP-609). Written before docker-ce is
# installed so dockerd starts with it; uncapped logs filled hosts (SOP-475).
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "100m", "max-file": "3" }
}
JSON
apt-get install -y docker-ce docker-ce-cli containerd.io
usermod -aG docker ubuntu
service docker start

# docker-compose
curl -L "https://github.com/docker/compose/releases/download/${DOCKER_COMPOSE_VERSION}/docker-compose-$(uname -s)-$(uname -m)" \
     -o "/usr/local/bin/docker-compose"
sudo chmod +x /usr/local/bin/docker-compose
curl -L "https://raw.githubusercontent.com/docker/compose/$(docker-compose version --short)/contrib/completion/bash/docker-compose" \
     -o "/etc/bash_completion.d/docker-compose" || true

# ruby
# best-effort: the keyserver is flaky and rvm-installer fetches the keys itself
# if they are missing, so a failure here must not abort the run.
sudo gpg2 --keyserver hkp://pgp.mit.edu \
    --recv-keys 409B6B1796C275462A1703113804BB82D39DC0E3 7D2BAF1CF37B13E2069D6956105BD0E739499BDB || true
# Fallback when the keyserver returns nothing ("keyserver receive failed: No data"), which makes
# rvm-installer fail its signature check and abort the run. Same two keys, RVM's documented source;
# the import is checked against the expected fingerprints.
for k in mpapis pkuczynski; do curl -fsSL "https://rvm.io/$k.asc" | sudo gpg2 --import - ; done
for fp in 409B6B1796C275462A1703113804BB82D39DC0E3 7D2BAF1CF37B13E2069D6956105BD0E739499BDB; do
  sudo gpg2 --list-keys "$fp" >/dev/null || { echo "FATAL: RVM signing key $fp missing" >&2; exit 1; }
done
curl -sSL "$RVM_INSTALLER_URL" | bash -s stable --ruby=2.5
# gems pinned to the last releases that support Ruby 2.5: the latest bundler (>= 3.2),
# dotenv (>= 3.0) and pry (via io-console >= 2.6) all fail to install here, which under
# set -e (correctly) aborts provisioning.
for gem_spec in "bundler 2.3.27" "dotenv 2.8.1" "pry 0.14.2"; do
  read -r gem_name gem_version <<< "$gem_spec"
  /usr/local/rvm/bin/rvm 2.5 do gem install "$gem_name" -v "$gem_version" --no-document
done
usermod -aG rvm root
usermod -aG rvm ubuntu

# CloudWatch agent (SOP-621). Replaces the CloudWatch Monitoring Scripts
# (/root/aws-scripts-mon, Perl, IMDSv1 only), which stop silently once the
# launch template requires IMDSv2. Same namespace (System/Linux), every 60s.
# MemoryUtilization and DiskSpaceUtilization keep their names, per InstanceId
# and per AutoScalingGroupName as before. Used/available are now in bytes under
# the agent's own names (mem_used, mem_available, disk_used, disk_free) rather than the
# Perl script's MB/GB MemoryUsed/MemoryAvailable/DiskSpaceUsed/DiskSpaceAvailable.
# The instance role already has CloudWatchAgentServerPolicy.
curl -fsSL "$CWAGENT_DEB_URL" -o /tmp/amazon-cloudwatch-agent.deb
dpkg -i -E /tmp/amazon-cloudwatch-agent.deb
rm /tmp/amazon-cloudwatch-agent.deb
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'JSON'
{
  "agent": { "metrics_collection_interval": 60, "omit_hostname": true },
  "metrics": {
    "namespace": "System/Linux",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "aggregation_dimensions": [["InstanceId"], ["AutoScalingGroupName"]],
    "metrics_collected": {
      "mem": {
        "measurement": [
          { "name": "mem_used_percent", "rename": "MemoryUtilization", "unit": "Percent" },
          { "name": "mem_used", "unit": "Bytes" },
          { "name": "mem_available", "unit": "Bytes" }
        ]
      },
      "disk": {
        "resources": ["/"],
        "drop_device": true,
        "measurement": [
          { "name": "used_percent", "rename": "DiskSpaceUtilization", "unit": "Percent" },
          { "name": "used", "unit": "Bytes" },
          { "name": "free", "unit": "Bytes" }
        ]
      }
    }
  }
}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json


# awscli
curl "$AWSCLI_INSTALLER_URL" -o "awscli-bundle.zip"
unzip awscli-bundle.zip
./awscli-bundle/install -i /usr/local/aws -b /usr/local/bin/aws

# kernel headers (build dependency for native extensions)
apt-get -y install "linux-headers-$(uname -r)"


# codedeploy - agent is already installed (see above); start it now that
# docker-compose is confirmed present.
service codedeploy-agent start