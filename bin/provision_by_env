#!/bin/bash

# fail fast: a failed step must stop provisioning, not yield a half-configured host
set -euo pipefail

ENV="$1"
# version hard-coded to prevent installing unknown (potentially broken) versions of compose.
# https://github.com/docker/compose/issues/6268#issuecomment-576628705
DOCKER_COMPOSE_VERSION=1.25.4
RVM_INSTALLER_URL="https://raw.githubusercontent.com/wayneeseguin/rvm/stable/binscripts/rvm-installer"
CODEDEPLOY_INSTALLER_URL="https://aws-codedeploy-us-east-1.s3.amazonaws.com/latest/install"
MONITORING_INSTALLER_URL="https://aws-cloudwatch.s3.amazonaws.com/downloads/CloudWatchMonitoringScripts-1.2.2.zip"
# pinned: the unversioned bundle now requires Python >= 3.10, which these hosts lack
AWSCLI_INSTALLER_URL="https://s3.amazonaws.com/aws-cli/awscli-bundle-1.19.112.zip"

# hostname config (for sudo to work properly)
echo "$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)" "$(hostname)" | sudo tee -a /etc/hosts

# packages
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
               -o Dpkg::Options::="--force-confdef" \
               -o Dpkg::Options::="--force-confold"
apt-get install -y \
        jq \
        rpm \
        htop \
        libaio1 \
        libpq-dev \
        libmysqlclient-dev \
        mysql-client \
        libgmp3-dev \
        wget \
        python-pip \
        unzip \
        libwww-perl \
        libdatetime-perl \
        gnupg2

# docker - set repository
apt-get update
apt-get install -y \
        apt-transport-https \
        ca-certificates \
        curl \
        gnupg-agent \
        software-properties-common
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo apt-key add -
add-apt-repository "deb [arch=amd64] https://download.docker.com/linux/ubuntu \
                   $(lsb_release -cs) \
                   stable"
# docker - cap json-file container logs (SOP-609). Written before docker-ce is
# installed so dockerd starts with it; uncapped logs filled hosts (SOP-475).
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "100m", "max-file": "3" }
}
JSON
# docker - install docker CE
apt-get update
apt-get install -y \
        docker-ce \
        docker-ce-cli \
        containerd.io
# docker - post installation
usermod -aG docker ubuntu
service docker start

# docker-compose
# --fail: treat HTTP errors (404, rate-limit) as a real failure instead of writing
#         an empty/error-page file and returning 0.
# --retry: absorb transient network blips on a freshly-booted host.
if ! curl -fL --retry 5 --retry-delay 5 \
     "https://github.com/docker/compose/releases/download/${DOCKER_COMPOSE_VERSION}/docker-compose-$(uname -s)-$(uname -m)" \
     -o "/usr/local/bin/docker-compose"; then
  echo "FATAL: failed to download docker-compose ${DOCKER_COMPOSE_VERSION} after retries" >&2
  exit 1
fi
sudo chmod +x /usr/local/bin/docker-compose
if ! docker-compose version --short >/dev/null 2>&1; then
  echo "FATAL: downloaded docker-compose binary is not executable/working" >&2
  exit 1
fi
curl -fL --retry 5 --retry-delay 5 \
     "https://raw.githubusercontent.com/docker/compose/$(docker-compose version --short)/contrib/completion/bash/docker-compose" \
     -o "/etc/bash_completion.d/docker-compose" || true

# codedeploy - installed and started here, after docker-compose but before
# RVM (below) changes what 'ruby' resolves to for a login shell, which broke
# CodeDeploy's installer when this block ran after RVM.
apt-get -y install ruby-full
cd /home/ubuntu || true
wget "$CODEDEPLOY_INSTALLER_URL"
chmod +x install
bash -l -c "sudo ./install auto"
#sudo ./install auto
service codedeploy-agent start

# ruby
# best-effort: the keyserver is flaky and rvm-installer fetches the keys itself
# if they are missing, so a failure here must not abort the run.
sudo gpg2 --keyserver hkp://pgp.mit.edu \
    --recv-keys 409B6B1796C275462A1703113804BB82D39DC0E3 7D2BAF1CF37B13E2069D6956105BD0E739499BDB || true
# Fallback when the keyserver returns nothing ("keyserver receive failed: No data"), which makes
# rvm-installer fail its signature check and abort the run. Same two keys, RVM's documented source;
# the import is checked against the expected fingerprints.
for k in mpapis pkuczynski; do curl -fsSL "https://rvm.io/$k.asc" | sudo gpg2 --import - ; done
for fp in 409B6B1796C275462A1703113804BB82D39DC0E3 7D2BAF1CF37B13E2069D6956105BD0E739499BDB; do
  sudo gpg2 --list-keys "$fp" >/dev/null || { echo "FATAL: RVM signing key $fp missing" >&2; exit 1; }
done
curl -sSL "$RVM_INSTALLER_URL" | bash -s stable --ruby=2.5
# gems pinned to the last releases that support Ruby 2.5: the latest bundler (>= 3.2),
# dotenv (>= 3.0) and pry (via io-console >= 2.6) all fail to install here, which under
# set -e (correctly) aborts provisioning.
for gem_spec in "bundler 2.3.27" "dotenv 2.8.1" "pry 0.14.2"; do
  read -r gem_name gem_version <<< "$gem_spec"
  /usr/local/rvm/bin/rvm 2.5 do gem install "$gem_name" -v "$gem_version" --no-document
done
usermod -aG rvm root
usermod -aG rvm ubuntu

# CloudWatch Monitoring
command="/root/aws-scripts-mon/mon-put-instance-data.pl \
  --mem-util \
  --mem-used \
  --mem-avail \
  --disk-path=/ \
  --disk-space-util \
  --disk-space-used \
  --disk-space-avail \
  --verbose \
  --from-cron \
  --auto-scaling"
job="* * * * * $command"
curl -sSL "$MONITORING_INSTALLER_URL" -o "/root/aws-scripts-mon.zip"
unzip /root/aws-scripts-mon.zip -d /root && rm /root/aws-scripts-mon.zip
cat <(grep -F -i -v "$command" <(crontab -l)) <(echo "$job") | crontab -

# awscli
curl "$AWSCLI_INSTALLER_URL" -o "awscli-bundle.zip"
unzip awscli-bundle.zip
./awscli-bundle/install -i /usr/local/aws -b /usr/local/bin/aws

# kernel headers (build dependency for native extensions)
apt-get -y install "linux-headers-$(uname -r)"

# microservice configuration
# Inlined from the archived sesac/docker-cfg repo (SOP-609), with the Consul
# agent's client address on 127.0.0.1 instead of 0.0.0.0 (SOP-586 B0).
case "$ENV" in
  prod) CONSUL_HOST="consul.sesac.com" ;;
  qa)   CONSUL_HOST="qa-consul.sesac.com" ;;
  dev)  CONSUL_HOST="dev-consul.sesac.com" ;;
  *)    echo "FATAL: unknown ENV '$ENV' (expected prod, qa or dev)" >&2; exit 1 ;;
esac
echo "CONSUL_HOST=\"$CONSUL_HOST\"" > .env

cat > docker-compose.yml <<'YAML'
version: '3'

services:
  consul_agent:
    image: consul:1.5.2
    environment:
      CONSUL_LOCAL_CONFIG: '{"leave_on_terminate": true}'
    command: agent -bind=${HOST_IP}
                   -client=127.0.0.1 ${JOIN_IP}
                   -ui
    network_mode: 'host'
    ports:
      - '8300:8300'
      - '8301:8301/tcp'
      - '8301:8301/udp'
      - '8302:8302/tcp'
      - '8302:8302/udp'
      - '8400:8400'
      - '8500:8500'
      - '8600:8600/tcp'
      - '8600:8600/udp'
  proxy_sidecar:
    image: micro/micro:v1.13.2
    command: --api_handler=proxy
             --api_namespace=go.micro.srv
             --api_address=0.0.0.0:8181
             --registry_address=127.0.0.1:8500
             --register_interval=5
             --register_ttl=10
             --registry=consul
             --enable_stats api
    depends_on:
      - consul_agent
    network_mode: 'host'
    ports:
      - '8181:8181'
YAML

# shellcheck disable=SC1091
source ".env"

# IP address of server we are deploying on
HOST_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)

# List of nodes in the consul cluster, we will join this cluster
JOIN_IP=$(curl -sL "http://$CONSUL_HOST/v1/catalog/service/consul" | jq -r 'map("-retry-join="+.Address) | join(" ")')

# replace or append *_IP variables
sed -i "/^HOST_IP=/{h;s/=.*/=$HOST_IP/};\${x;/^\$/{s//HOST_IP=$HOST_IP/;H};x}" .env
sed -i "/^JOIN_IP=/{h;s/=.*/=$JOIN_IP/};\${x;/^\$/{s//JOIN_IP=$JOIN_IP/;H};x}" .env

docker-compose up -d
docker-compose ps
